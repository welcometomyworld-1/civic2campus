# ==============================================================================
# Civic2Campus Backend Environment Configuration Template
# ==============================================================================

# MongoDB Connection (MongoDB Atlas preferred; local MongoDB optionally supported)
# Example Atlas: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/
# Example Local: mongodb://localhost:27017
MONGODB_URI=
DB_NAME=civic2campus

# Security & Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend URL for CORS (Connects Vite React frontend at http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# AI Services (Backend only — never exposed to client)
AI_API_KEY=

# File Upload Storage Directory
UPLOAD_DIR=uploads

# Application Settings
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
